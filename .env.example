# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# DATABASE_URL: PostgreSQL + pgvector connection string (production target)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/geomine_intel"

# JWT_SECRET: Secret for signing user session tokens
JWT_SECRET="cmpdi_cil_sih26023_secure_jwt_token_secret"
